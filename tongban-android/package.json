{
  "name": "tongban-android-preview",
  "version": "0.14.0-dev.7",
  "private": true,
  "description": "愚笨者 Android 应用",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "web:copy": "node scripts/copy-web.mjs",
    "web:prepare": "node scripts/prepare-web.mjs",
    "sync": "pnpm web:prepare && cap sync android",
    "test": "node --test tests/*.test.mjs",
    "android:open": "cap open android",
    "android:debug": "pnpm sync && cd android && ./gradlew assembleDebug",
    "android:release": "pnpm sync && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3"
  }
}
