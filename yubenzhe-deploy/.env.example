RELEASE_TAG=0.14.0-dev.9
FRONT_PORT=18808
ADMIN_PORT=18809
FRONT_ORIGIN=http://127.0.0.1:18808
ADMIN_ORIGIN=http://127.0.0.1:18809

# Default: requests and reviews work; inference remains disabled.
AI_PROVIDER=disabled
AI_MODEL=
AI_API_KEY=
# For DeepSeek (OpenAI-compatible default; override URL together with allowlist):
#   AI_PROVIDER=openai
#   AI_MODEL=deepseek-v4-flash
#   AI_API_KEY=
# Do NOT use legacy ids deepseek-chat / deepseek-reasoner (retired 2026-07-24).
# For the optional local-model profile: AI_PROVIDER=ollama, AI_MODEL=qwen3:0.6b
OLLAMA_IMAGE=ollama/ollama@sha256:684d8674b4315fa18f4f0e973a118ec2652ed96f67563277839985175858e0ba

# M0 is opt-in and loopback only; keep false on all deployed services.
M0_SIMULATION=false
# Use node scripts/start-m0.mjs for an isolated local profile.
# EMAIL_OTP_SECRET must be a persistent secret for a configured email adapter.

# Real email delivery (optional). When unset, email verification stays disabled.
# Existing M0 and internal-preview profiles keep their simulated mail behavior.
# EMAIL_PROVIDER=http
# EMAIL_ENDPOINT=https://api.example-mail.com/v3/mail/send
# EMAIL_API_KEY_FILE=/run/secrets/email_api_key
# EMAIL_FROM=no-reply@yourdomain.com
# EMAIL_OTP_SECRET=<at least 32 random characters; persistent; never rotate casually>
# EMAIL_API_KEY=  # Optional fallback only; a configured key file always takes priority.
# HTTP body contract and deployment notes: MAIL-DELIVERY.txt

# Overseas deployment. A region setting does NOT migrate an existing server.
DEPLOY_REGION=us-west-2
YBZ_PREVIEW_ORIGIN=https://66.42.56.29
AI_BASE_URL=https://api.deepseek.com/v1
AI_ALLOWED_HOSTS=api.deepseek.com
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_ALLOWED_HOSTS=ollama,localhost,127.0.0.1,[::1]
BSC_TESTNET_RPC_URLS=["https://bsc-testnet-dataseed.bnbchain.org","https://bsc-testnet.bnbchain.org"]
# Frontend and native build-time overrides (run build after editing):
BSC_TESTNET_EXPLORER_URL=https://testnet.bscscan.com
BSC_TESTNET_FAUCET_URL=https://docs.bnbchain.org/bnb-smart-chain/developers/faucet/
OLLAMA_DOWNLOAD_URL=https://ollama.com/download
# Backend skeleton only: supplying keys alone does NOT activate purchases.
DESKTOP_PROVIDER=disabled
DESKTOP_REGION=us-west-2
DESKTOP_CREDENTIALS_FILE=
# If a future adapter uses /run/ybz-desktop/credentials.json, place it under secrets/desktop.
# 32 random bytes encoded as base64 or 64 hex digits; persist/backup separately.
DESKTOP_CRED_KEY=
DESKTOP_CLIENT_URLS_JSON=
ACME_DIRECTORY=https://acme-v02.api.letsencrypt.org/directory
