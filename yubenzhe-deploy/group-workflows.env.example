# Optional NEW isolated internal test environment only. Do not copy real secrets here.
# Existing start.mjs authentication/origin/database configuration is still required.
# Group module: ROLE=frontend plus loopback M0_SIMULATION=true OR HTTPS
# INTERNAL_PREVIEW=true (PUBLIC_FRONTEND=false, M0_SIMULATION=false).
# Default: no user signing for group task payments until explicitly enabled.
YBZ_GROUP_TESTNET_PAYMENTS=false
# Optional process-owned HTTPS RPCs; chain 97 is checked on every verification.
# Use the same RPC list for the frontend build and server runtime; rebuild the UI.
# BSC_TESTNET_RPC_URLS=["https://bsc-testnet-dataseed.bnbchain.org","https://bsc-testnet.bnbchain.org"]

# Optional existing self-hosted free model. The local review launcher deliberately
# overrides AI_PROVIDER to disabled; use the established isolated start.mjs setup.
AI_PROVIDER=disabled
# AI_PROVIDER=ollama
# AI_MODEL=qwen3:0.6b
# OLLAMA_BASE_URL=http://ollama:11434
# OLLAMA_ALLOWED_HOSTS=ollama
# No wallet private keys, mnemonic phrases or wallet password belong on the server.
