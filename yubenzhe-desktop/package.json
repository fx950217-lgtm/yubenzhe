{
  "name": "yubenzhe-desktop",
  "productName": "愚笨者",
  "version": "0.12.1",
  "description": "愚笨者桌面客户端，钱包与熟人社交",
  "private": true,
  "main": "src/main.cjs",
  "author": {
    "name": "愚笨者"
  },
  "license": "UNLICENSED",
  "scripts": {
    "sync:web": "node scripts/copy-web.mjs",
    "test": "node --test tests/*.test.cjs",
    "build:win": "electron-builder --win nsis zip --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "app.yubenzhe.desktop.preview",
    "productName": "愚笨者",
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true
    },
    "npmRebuild": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/*.cjs",
      "web/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "executableName": "Yubenzhe",
      "signExecutable": false,
      "artifactName": "yubenzhe-${version}-windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "愚笨者",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "displayLanguageSelector": true,
      "artifactName": "yubenzhe-${version}-windows-x64-setup.exe"
    }
  }
}
